{
  "name": "agent-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "description": "Modular Agent 前端 — Agent对话 + 角色扮演 + 知识库 + 世界体系(GraphRAG 全局问答)",
  "scripts": {
    "dev": "vite",
    "dev:full": "cross-env NODE_ENV=development concurrently -k -n vite,tsc,electron \"vite\" \"tsc -p electron/tsconfig.json --watch\" \"wait-on http://localhost:3001 && electron .\"",
    "build": "tsc --noEmit && vite build",
    "build:analyze": "vite build --mode analyze",
    "build:dev": "vite build --mode development",
    "build:electron": "tsc -p electron/tsconfig.json && vite build",
    "pack": "npm run build:electron && electron-builder --win",
    "electron:start": "electron .",
    "preview": "vite preview",
    "preview:prod": "vite preview --mode production --port 4000",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "lint:report": "eslint . --format json --output-file eslint-report.json",
    "format": "prettier --write \"**/*.{ts,tsx,js,cjs,mjs,css,scss,md,json,jsonc,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,cjs,mjs,css,scss,md,json,jsonc,html}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prepare": "node -e \"try{require('child_process').execSync('husky .husky',{stdio:'ignore'})}catch(e){}\" || exit 0",
    "clean": "rimraf dist node_modules/.vite coverage playwright-report test-results eslint-report.json",
    "check-all": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-force-graph-2d": "^1.29.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^7.18.1",
    "rehype-sanitize": "^6.0.0",
    "zustand": "^5.0.14"
  },
  "optionalDependencies": {
    "@sentry/react": "^8.40.0",
    "web-vitals": "^6.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "autoprefixer": "^10.4.16",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.17.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.11",
    "postcss": "^8.4.32",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "rimraf": "^6.0.1",
    "rollup-plugin-visualizer": "^5.13.1",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.18.2",
    "vite": "^5.0.8",
    "vitest": "^2.1.8",
    "wait-on": "^9.1.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "build": {
    "appId": "dev.aurora.agent",
    "productName": "Aurora Agent",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
