# ─────────────────────────────────────────────
# 前端环境变量模板
# 复制为 .env.local 进行本地覆盖（.env.local 不入版本控制）
# 所有客户端变量必须以 VITE_ 前缀开头，否则不会暴露给浏览器
# ─────────────────────────────────────────────

# 应用元信息
VITE_APP_TITLE=Modular Agent
VITE_APP_VERSION=1.0.0

# API 基础路径（同源代理时留空字符串；独立部署时填完整 URL）
VITE_API_BASE_URL=/api/v1/agent

# 后端服务地址（仅 dev 代理用，不暴露给浏览器）
# 实际代理目标在 vite.config.ts 中配置
VITE_PROXY_TARGET=http://localhost:8080

# 后端 Bearer Token（仅 Vite/nginx 代理注入，禁止使用 VITE_ 前缀）
# 与仓库根目录 .env 中的 AGENT_API_TOKEN 保持一致
AGENT_API_TOKEN=change-me-to-a-long-random-token

# 环境标识（development / staging / production），由 Vite 自动注入
# VITE_ 环境变量在 import.meta.env 中访问

# Sentry 错误监控 DSN（留空则不启用 Sentry）
VITE_SENTRY_DSN=

# 性能监控采样率（0~1，生产环境建议 0.1）
VITE_TRACES_SAMPLE_RATE=0.1

# 是否开启调试模式（开启后输出详细日志、React DevTools 高亮）
VITE_DEBUG=false

# 是否启用 PWA（生产环境建议 true）
VITE_ENABLE_PWA=false

# 是否启用 mock 数据（开发阶段可临时开启）
VITE_ENABLE_MOCK=false

# 默认语言
VITE_DEFAULT_LOCALE=zh-CN
