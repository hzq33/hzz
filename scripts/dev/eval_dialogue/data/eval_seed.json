   "card_dialogues": [
    {
     "speaker": "雷姆",
     "content": "爱蜜莉雅小姐,还有碧翠丝酱……",
     "context": "第五章『王国与帝国』"
    },
    {
     "speaker": "雷姆",
     "content": "我想敌人不会只有那头邪龙。跟大家会合比较好吧?",
     "context": "第六章『贝尔斯特兹•彭达冯』"
    },
    {
     "speaker": "雷姆",
     "content": "──!我、我只是照着你说的去做而已。",
