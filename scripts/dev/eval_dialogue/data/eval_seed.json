   "card_dialogues": [
    {
     "speaker": "八奈见",
     "content": "再不去的话,华恋酱就要去英国了。那样就行了吗?",
     "context": "第12章"
    },
    {
     "speaker": "八奈见",
     "content": "她说这话不是摆明让你去见她吗!",
     "context": "第12章"
    },
    {
     "speaker": "八奈见",
     "content": "为什么,能知道那种事?",
     "context": "第12章"
    },
    {
     "speaker": "八奈见",
     "content": "就是懂啊!因为我也一直对草介……",
     "context": "第12章"
    },
    {
     "speaker": "八奈见",
     "content": "嗯,这样就好",
     "context": "第12章"
    },
    {
     "speaker": "八奈见",
     "content": "快去吧。华恋酱在等着你呢",
     "context": "第12章"
    },
    {
     "speaker": "八奈见",
     "content": "华恋酱人很好呢,不让她幸福的话我可不答应噢",
     "context": "第12章"
    },
    {
     "speaker": "八奈见",
     "content": "加油喔。被甩了的话,我可以勉为其难听听你的抱怨",
     "context": "第12章"
    }
   ]
  },
  "温水佳树": {
   "aliases": [
    "佳树",
    "春树"
   ],
   "speakers": [
    "温水佳树"
   ],
   "series_id": "败犬女主太多了",
   "source_work": "败犬女主太多了",
   "catchphrases": [],
   "source_doc_ids": [
