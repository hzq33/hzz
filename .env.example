# Required LLM provider configuration
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_FALLBACK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

# API boundary (required — fail-closed when unset)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_TOKEN=change-me-to-a-long-random-token
# Explicit browser origins only — never use * (invalid value aborts startup)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Tool isolation
AGENT_WORKSPACE_DIR=data/workspace
EXECUTE_CODE_ENABLED=false
# EXECUTE_CODE_TIMEOUT=30
# EXECUTE_CODE_CPU_SECONDS=20
# EXECUTE_CODE_MAX_MEM_MB=256
# HITL for execute_code / file_operation write (default on)
# story_analysis：关系/事件索引（story_v3）
# max_tokens / per_type_cap=3 / map_retry / entity_filter / chapter_quota 见 config.yaml story_analysis
# AGENT_TOOL_HITL=1
# AGENT_TOOL_HITL_TIMEOUT=120
# Set to 1 to restore legacy Planner→Executor path (default: native tool calling)
# AGENT_USE_PLANNER=0
# Set to 1 to allow web_search demo corpus when DuckDuckGo returns nothing (tests only)
# WEB_SEARCH_ALLOW_DEMO=0

# Optional: CLUENER+LLM character inventory on ingest
# NOVEL_CHAR_INVENTORY_ENABLED=true
# Seed threshold: median (default) or fixed
# NOVEL_CHAR_SEED_THRESHOLD_MODE=median
# If set, forces fixed mode with this threshold
# NOVEL_CHAR_SEED_MIN_MENTIONS=3

# Reranker (config.yaml default on; auto → Qwen3 if weights exist else keyword)
# CI forces keyword via NOVEL_RERANKER_PROVIDER / CI=true — see docs/RERANKER.md
# NOVEL_RERANKER_ENABLED=1
# NOVEL_RERANKER_PROVIDER=keyword
# NOVEL_RERANKER_PROVIDER=qwen3

# Optional RAGAS/DeepEval LLM judge (not a PR gate) — docs/EVAL_LLM_JUDGE.md
# EVAL_LLM_JUDGE=1

# Wave C — cost / budget / rate limit
# AGENT_SESSION_TOKEN_BUDGET=200000
# AGENT_RATE_LIMIT_RPS=5
# AGENT_RATE_LIMIT_BURST=10
# AGENT_LLM_CIRCUIT_FAILURES=3
# AGENT_LLM_CIRCUIT_OPEN_SEC=30
# AGENT_LLM_RETRY_JITTER=1
# AGENT_LLM_PRICE_DEFAULT=0.14,0.28
# AGENT_LLM_PRICE_DEEPSEEK_V4_FLASH=0.14,0.28

# Optional: dialogue extract — default cloud_chapter (per-chapter LLM)
# NOVEL_DIALOGUE_ATTR_ENABLED=true
# NOVEL_DIALOGUE_ATTR_PROVIDER=cloud_chapter
# legacy short-window: NOVEL_DIALOGUE_ATTR_PROVIDER=legacy_window

# Optional local model
LOCAL_LLM_ENABLED=false

# Data retention / sessions
AGENT_SESSION_KEEP=50
AGENT_JOB_TTL_HOURS=72
AGENT_IMP_MAX_SESSIONS=20
# Process-local asyncio job concurrency (global semaphore)
AGENT_JOB_CONCURRENCY=2
# Per-type caps (in addition to global). Upload defaults to 1 when unset.
AGENT_JOB_UPLOAD_CONCURRENCY=1
# AGENT_JOB_STORY_CONCURRENCY=2
# AGENT_JOB_CHARACTER_CONCURRENCY=2
# Grace period when cancelling in-flight jobs on process shutdown
AGENT_JOB_SHUTDOWN_GRACE_SEC=15
# inprocess (default): API runs jobs via asyncio.
# external: API only writes pending rows; run `python -m src.jobs.worker`
AGENT_JOB_WORKER_MODE=inprocess
# AGENT_JOB_LEASE_SEC=600
# AGENT_JOB_WORKER_POLL_SEC=1.0
# sqlite (default, multi-process safe WAL) | json (legacy per-file)
AGENT_SESSION_BACKEND=sqlite
# AGENT_SESSION_DB=data/sessions/sessions.db
AGENT_JOB_BACKEND=sqlite
# AGENT_JOB_DB=data/jobs/jobs.db
# AGENT_LOG_FORMAT=json
# AGENT_LOG_LEVEL=INFO
# Novel import sandbox (defaults to data/uploads)
# NOVEL_IMPORT_DIR=data/uploads
# Dev only: when LanceDB is empty, auto-ingest tests/test_novel_data/镜湖风云录.md
# Default OFF. Set to 1 only for local demo without uploading.
# AGENT_AUTO_INDEX_TEST_NOVEL=0
#
# Dev note: `uvicorn --reload` kills the process on file change — long Jobs
# (upload / story_analysis) become orphan_after_restart on next boot.
# Production: do NOT use --reload.
# Observability (optional — fail-open when unset)
TELEMETRY_ENABLED=true
OTEL_SERVICE_NAME=makers-agent
# Prefer OTLP in prod; console spam off by default
OTEL_CONSOLE_EXPORT=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# 硅基流动 (SiliconFlow) 预留 — OpenAI 兼容 API: https://api.siliconflow.cn/v1
# 启用方式见 docs/LLM_PROVIDER_SILICONFLOW.md（设置页可配 siliconflow provider）
SILICONFLOW_API_KEY=
# Prometheus scrape: GET http://localhost:8080/metrics (network-restrict in prod)
